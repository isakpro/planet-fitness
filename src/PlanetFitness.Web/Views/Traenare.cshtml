@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Tranare>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "layout.cshtml";
}
<div class="detalj">
    @if (Model.Bild != null)
    {
        <img class="detalj-bild" src="@Model.Bild.GetCropUrl(width: 900, furtherOptions: "&format=webp")" alt="@Model.Name">
    }
    <div class="detalj-text">
        <h1>Tränare: @Model.Name</h1>
        @Model.Presentation
        @if (Model.Specialomraden != null && Model.Specialomraden.Any())
        {
            <p>Specialområden:</p>
            <ul>
                @foreach (var specialomrade in Model.Specialomraden)
                {
                    <li>@specialomrade</li>
                }
            </ul>
        }
    </div>
</div>
