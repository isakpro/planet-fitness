@using System.Text.RegularExpressions
@using Umbraco.Cms.Core.Media
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Strings
@model IHtmlEncodedString?
@inject IImageUrlGenerator ImageUrlGenerator
@{
    var html = Model?.ToHtmlString() ?? "";

    // Bilderna i texten hämtas i hög upplösning som webp så att de blir skarpa i full bredd
    html = Regex.Replace(html, @"src=""(/media/[^""?]+)\?[^""]*""", match =>
    {
        var url = ImageUrlGenerator.GetImageUrl(new ImageUrlGenerationOptions(match.Groups[1].Value)
        {
            Width = 1600,
            ImageCropMode = ImageCropMode.Max,
            FurtherOptions = "format=webp"
        });
        return $"src=\"{System.Net.WebUtility.HtmlEncode(url)}\"";
    });
}
@Html.Raw(html)
