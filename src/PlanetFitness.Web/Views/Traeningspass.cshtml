@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Traningspass>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "layout.cshtml";
}
<div class="detalj">
    @if (Model.Bild != null)
    {
        <img class="detalj-bild" src="@Model.Bild.GetCropUrl(width: 900, furtherOptions: "&format=webp")" alt="@Model.Name">
    }
    <div class="detalj-text">
        <h1>Träningspass: @Model.Name</h1>
        @Model.Beskrivning
        <p>@Model.DagOchTid</p>
        <p>@Model.Langd minuter</p>
        @if (Model.Tranare != null)
        {
            <p>Tränare: <a href="@Model.Tranare.Url()">@Model.Tranare.Name</a></p>
        }
    </div>
</div>
