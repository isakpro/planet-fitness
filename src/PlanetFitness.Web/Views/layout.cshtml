@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
    var metaTitel = Model.Value<string>("metaTitel");
    if (metaTitel.IsNullOrWhiteSpace())
    {
        metaTitel = Model.Name;
    }
    
    var metaDescription = Model.Value<string>("metaDescription");
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@metaTitel - Planet Fitness</title>
    @if (!metaDescription.IsNullOrWhiteSpace())
    {
        <meta name="description" content="@metaDescription">
    }
</head>
<body>
    <header>
        <p>Planet Fitness</p>
        @await Html.PartialAsync("meny")
    </header>

    <main>
     @await Html.PartialAsync("brodsmulor")
        @RenderBody()
    </main>

    <footer>
        <p>Planet Fitness</p>
    </footer>
</body>
</html>