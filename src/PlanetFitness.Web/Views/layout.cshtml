@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var metaTitel = Model.Value<string>("metaTitel");
    if (metaTitel.IsNullOrWhiteSpace())
    {
        metaTitel = Model.Name;
    }
    
    var metaDescription = Model.Value<string>("metaDescription");
}

<!DOCTYPE html>
<html lang="sv">

<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap">
    <link rel="stylesheet" href="/css/site.css">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@metaTitel - Planet Fitness</title>
    @if (!metaDescription.IsNullOrWhiteSpace())
    {
        <meta name="description" content="@metaDescription">
    }
</head>

<body>
    <header>
        <a href="/" class="logo">Planet Fitness</a>
        @await Html.PartialAsync("meny")
    </header>

    <main>
        @await Html.PartialAsync("brodsmulor")
        @RenderBody()
    </main>

    <footer>
        <p>Planet Fitness</p>
    </footer>
</body>

</html>