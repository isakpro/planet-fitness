@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Sida>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "layout.cshtml";
    var passLista = Model.Children<Traningspass>();
    var tranarLista = Model.Children<Tranare>();
}
<h1>@Model.Name</h1>
<p class="ingress">@Model.Ingress</p>
<div class="brodtext">
    @await Html.PartialAsync("brodtext", Model.Brodtext)
</div>
@if (passLista != null && passLista.Any())
{
    <ul class="pass-lista">
        @foreach (var pass in passLista)
        {
            <li class="pass-kort">
                <h2><a href="@pass.Url()">@pass.Name</a></h2>
                <p>@pass.DagOchTid · @pass.Langd min</p>
                @if (pass.Tranare != null)
                {
                    <p>Tränare: <a href="@pass.Tranare.Url()">@pass.Tranare.Name</a></p>
                }
            </li>
        }
    </ul>
}
@if (tranarLista != null && tranarLista.Any())
{
    <ul class="tranar-lista">
        @foreach (var tranare in tranarLista)
        {
            <li class="tranar-kort">
                <a href="@tranare.Url()">
                    @if (tranare.Bild != null)
                    {
                        <img src="@tranare.Bild.GetCropUrl(width: 600, furtherOptions: "&format=webp")" alt="@tranare.Name">
                    }
                    <h2>@tranare.Name</h2>
                </a>
                @if (tranare.Specialomraden != null && tranare.Specialomraden.Any())
                {
                    <p>@string.Join(" · ", tranare.Specialomraden)</p>
                }
            </li>
        }
    </ul>
}