@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Startsida>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "layout.cshtml";
}
<div class="detalj">
    @if (Model.HeroBild != null)
    {
        <img class="detalj-bild" src="@Model.HeroBild.GetCropUrl(width: 900, furtherOptions: "&format=webp")" alt="@Model.HeroBild.Name">
    }
    <div class="detalj-text">
        <h1>@Model.Name</h1>
        <p class="ingress">@Model.Ingress</p>
        <div class="brodtext">
            @await Html.PartialAsync("brodtext", Model.Brodtext)
        </div>
    </div>
</div>
